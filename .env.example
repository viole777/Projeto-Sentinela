# Copie este arquivo para .env e ajuste os valores locais.
PORT=3000
NODE_ENV=development

# Supabase (pooler em modo sessão):
# postgresql://postgres.<PROJECT_REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres
# A senha é a do banco (Project Settings → Database → Connection string).
DATABASE_URL=postgres://usuario:senha@host:5432/sentinela
PGSSL=require

# Chave da API (IA). Preencha apenas no .env local ou nas Environment Variables do Render.
# Nunca commit este arquivo com o valor real.
GEMINI_API_KEY=

# Endpoint e modelo da integração de IA. Apontam para o endpoint OpenAI-compatível
# oficial do Gemini (mesmo formato de requisição usado pelo backend).
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-3.6-flash
